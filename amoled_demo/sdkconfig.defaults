CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# The RGB panel scans out of PSRAM all the time. Running code from PSRAM too means flash writes
# (settings, updates) don't pause the cache, which would make the picture jump.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# (Not CONFIG_LCD_RGB_RESTART_IN_VSYNC: restarting the panel's DMA every frame is itself what shifts the picture when the
# VSYNC interrupt is late, ESP-IDF warns. The picture broke with it on and stayed broken until a restart of the LCD
# controller or the panel, either of which sometimes fixed it and sometimes didn't (2026-11-01). Without it, the driver
# restarts the DMA only when a frame's bounce-buffer refills came up short.)
# PSRAM (and flash, which must match) at 120 MHz, as Waveshare's own firmware for this board runs it: the panel's scan-out and the drawing share it
# (octal PSRAM at 120 MHz is marked experimental: fine at steady temperatures)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
# Fewer of Wi-Fi's buffers kept in internal RAM (~23 KB back; ESP-IDF's own defaults without PSRAM, about): the panel's
# buffers leave internal RAM short, and the speaker and microphones hold ~18 KB of it once started. Plenty for what
# this board sends and gets (API calls, covers, a chat's 32 KB/s each way).
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=8
# More internal RAM back (the panel's strips and bounce buffers take ~110 KB of it):
# - the mDNS task's stack and its records in PSRAM
# (Wi-Fi's hot paths, small allocations (under 16 KB, the default) and what's drawn every frame stay in internal RAM:
# PSRAM's bandwidth is shared with the panel's scan-out, and every extra bit of traffic there showed as broken rows)
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# The system event task ran with ~300 bytes of its 2304 to spare (Wi-Fi's handlers log from it)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
# A bigger TCP window: Spotify's image server answers in 200-500 ms from here, and with 5.7 KB in flight a cover came
# at ~14 KB/s (a 45 KB album cover took up to 8 s). 32 KB in flight; lwIP's buffers come from PSRAM.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
